# Local Docker Compose example. Do not put real provider tokens in this file.
# Normally, run ./setup-local.sh instead; it generates .env with fresh local secrets.

CLIPROXYAPI_VERSION=7.2.138
TZ=Asia/Seoul

# Generated automatically by setup-local.sh / setup-local.ps1.
JWT_SECRET=REPLACE_ME
MANAGEMENT_API_KEY=REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME
COLLECTOR_API_KEY=REPLACE_ME
BACKUP_SCHEDULER_KEY=REPLACE_ME

# Optional local provider access (false is safer default).
ALLOW_LOCAL_PROVIDER_URLS=false

# Optional Telegram alerts; leave empty until configured in the dashboard.
CLIPROXY_TELEGRAM_BOT_TOKEN=
CLIPROXY_TELEGRAM_ALLOWED_USERS=

# Optional Perplexity sidecar; leave disabled unless you intentionally configure it.
# COMPOSE_PROFILES=perplexity
PERPLEXITY_COOKIES=
PERPLEXITY_SIDECAR_SECRET=
PERPLEXITY_SIDECAR_AUTO_UPDATE=true
UPDATE_CHECK_INTERVAL=3600
